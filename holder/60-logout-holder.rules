// Installed by logout-holder: let a local user in the active session start
// logout-holder.service (start only, that unit only) at logout.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "logout-holder.service" &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active && subject.user != "plasmalogin") {
        return polkit.Result.YES;
    }
});
