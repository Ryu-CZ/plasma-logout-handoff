+bool WorkspaceScene::backdropNeeded() const
+{
+    if (!m_startupWallpaper) {
+        return false;
+    }
+    const auto windows = workspace()->windows();
+    return std::ranges::none_of(windows, [](const Window *window) {
+        return window->isDesktop() && !window->isDeleted();
+    });
+}
+
+bool WorkspaceScene::paintStartupWallpaper(const RenderTarget &target, const RenderViewport &viewport, const Region &region)
+{
+    if (!backdropNeeded() || region.isEmpty() || waylandServer()->isScreenLocked()) {
+        return true;
+    }
+    const auto rect = viewport.renderRect();
+    const auto source = m_startupWallpaper->image().size();
+    const double scale = std::max(rect.width() / source.width(), rect.height() / source.height());
+    const QSizeF size = QSizeF(source) * scale;
+    m_startupWallpaper->setSize(size);
+    m_startupWallpaper->setPosition(rect.center() - QPointF(size.width(), size.height()) / 2);
+    return m_renderers[painted_delegate->renderDevice()]->renderItem(target, viewport, m_startupWallpaper.get(),
+                                                                     0, region & viewport.deviceRect(), WindowPaintData{}, {}, {});
+}
